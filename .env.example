RESEND_API_KEY=re_your_api_key_here
RECIPIENT_EMAIL=e@emanlegal.com
SENDER_EMAIL=intake@emanlegal.com

# Bearer token required by the /internal viewer (list-cases, get-case,
# update-case, delete-case, export-cases). Generate a strong random string and
# set this in the Netlify env panel.
INTERNAL_VIEWER_TOKEN=replace_with_a_long_random_string

# Optional: Slack incoming webhook URL. If set, every successful intake
# submission posts a summary (with deep-link to the viewer) to the channel.
# Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Optional: Microsoft Teams incoming webhook URL. Same per-submission summary
# is posted as a MessageCard with the disposition color-coded. Set up via
# Teams channel → Workflows → "Post to a channel when a webhook request is
# received" (or the legacy Incoming Webhook connector).
TEAMS_WEBHOOK_URL=

# Optional: public site URL used in Slack/Teams deep-links. Defaults to
# https://emanlegal.com when unset.
SITE_URL=https://emanlegal.com
